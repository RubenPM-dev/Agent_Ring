{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JARVIS: Verify Firmware",
      "type": "node-terminal",
      "request": "launch",
      "command": "\"${config:jarvis.arduinoCliPath}\" compile --verbose --fqbn \"${config:jarvis.arduinoFqbn}\" --build-path \"${workspaceFolder}/.vscode/.arduino-build\" \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "JARVIS: Verify Then Upload",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "JARVIS: Release Serial Port + Verify (Verbose)",
      "command": "bash \"${workspaceFolder}/scripts/arduino-cli-with-port-fallback.sh\" \"${config:jarvis.arduinoCliPath}\" upload --verbose --fqbn \"${config:jarvis.arduinoFqbn}\" --port \"${config:jarvis.arduinoPort}\" --build-path \"${workspaceFolder}/.vscode/.arduino-build\" \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "JARVIS: Upload Firmware",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "JARVIS: Release Serial Port",
      "command": "bash \"${workspaceFolder}/scripts/arduino-cli-with-port-fallback.sh\" \"${config:jarvis.arduinoCliPath}\" upload --verbose --fqbn \"${config:jarvis.arduinoFqbn}\" --port \"${config:jarvis.arduinoPort}\" --build-path \"${workspaceFolder}/.vscode/.arduino-build\" \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "JARVIS: Serial Monitor",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/scripts/arduino-cli-with-port-fallback.sh\" \"${config:jarvis.arduinoCliPath}\" monitor --verbose --port \"${config:jarvis.arduinoPort}\" --config baudrate=${config:jarvis.serialBaud}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
